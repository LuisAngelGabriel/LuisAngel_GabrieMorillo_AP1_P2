@page "/Productos/Index"
@using LuisAngel_GabrieMorillo_AP1_P2.Models
@using LuisAngel_GabrieMorillo_AP1_P2.Services
@inject EntradasService entradasService
@rendermode InteractiveServer

<PageTitle>Entradas de Productos Empacados</PageTitle>

<div class="container mt-4">
    <h3 class="mb-3 text-center">Entradas de Productos Empacados</h3>

    <div class="card mb-4">
        <div class="card-body">
            <div class="row">
                <div class="col-md-3">
                    <label>Filtrar por</label>
                    <select class="form-control">
                        <option>Entrada Id</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label>Búsqueda</label>
                    <input type="text" class="form-control" placeholder="0" />
                </div>
                <div class="col-md-3">
                    <label>Desde</label>
                    <input type="date" class="form-control" placeholder="dd/mm/aaaa" />
                </div>
                <div class="col-md-3">
                    <label>Hasta</label>
                    <input type="date" class="form-control" placeholder="dd/mm/aaaa" />
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end mb-3">
        <a class="btn btn-success" href="/Productos/Create" title="Crear Entrada">
            <i class="bi bi-plus"></i>
        </a>
    </div>

    @if (entradas == null)
    {
        <p><em>Cargando entradas...</em></p>
    }
    else
    {
        <div class="card">
            <div class="card-body">
                @if (entradas.Count == 0)
                {
                    <p class="text-center">No hay entradas registradas.</p>
                }
                else
                {
                    @foreach (var entrada in entradas)
                    {
                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h5>@entrada.EntradaId <span class="text-muted">@entrada.Fecha.ToShortDateString()</span></h5>
                                <a href="#" class="btn btn-sm btn-primary">Editar</a>
                            </div>
                            <div class="ms-4">
                                <p class="mb-1">@entrada.Concepto</p>
                                <p class="mb-1"><strong>Peso Total:</strong> @entrada.CantidadProducida.ToString("N2") Kg</p>
                            </div>
                        </div>
                        <hr />
                    }
                }

                <div class="mt-3">
                    <h6>Conteo de Entradas: @entradas.Count</h6>
                    <h6>Peso Total Acumulado: @entradas.Sum(e => e.CantidadProducida).ToString("N2") Kg</h6>
                </div>
            </div>
        </div>
    }
</div>

@code {
    List<Entradas> entradas;

    protected override async Task OnInitializedAsync()
    {
        entradas = await entradasService.Listar(e => true);
    }
}