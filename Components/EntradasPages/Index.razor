@page "/Productos/Index"
@using LuisAngel_GabrieMorillo_AP1_P2.Models
@using LuisAngel_GabrieMorillo_AP1_P2.Services
@inject EntradasService entradasService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Entradas de Productos Empacados</PageTitle>

<div class="container mt-4">
    <div class="card">
        <div class="card-header">
            <h3 class="mb-0">Entradas de Productos Empacados</h3>
        </div>

        <div class="card-body">
            <div class="d-flex justify-content-end mb-3">
                <a class="btn btn-success" href="/Productos/Create">Crear</a>
            </div>

            @if (entradas == null)
            {
                <p><em>Cargando entradas...</em></p>
            }
            else if (entradas.Count == 0)
            {
                <p class="text-center">No hay entradas registradas.</p>
            }
            else
            {
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Fecha</th>
                            <th>Concepto</th>
                            <th>Productos</th>
                            <th>Peso Total (kg)</th>
                            <th>Cantidad</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entrada in entradas)
                        {
                            <tr>
                                <td>@entrada.EntradaId</td>
                                <td>@entrada.Fecha.ToShortDateString()</td>
                                <td>@entrada.Concepto</td>
                                <td>@string.Join(", ", entrada.Detalles.Select(d => d.Producto?.Descripcion ?? "N/A"))</td>
                                <td>@entrada.CantidadProducida.ToString("N2")</td>
                                <td>@entrada.Detalles.Sum(d => d.Cantidad)</td>
                                <td class="text-center">
                                    <button class="btn btn-primary btn-sm" @onclick="() => EditarEntrada(entrada.EntradaId)">
                                        Editar
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="mt-3">
                    <h6>Conteo de Entradas: @entradas.Count</h6>
                    <h6>Peso Total Acumulado: @entradas.Sum(e => e.CantidadProducida).ToString("N2") Kg</h6>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<Entradas> entradas;

    protected override async Task OnInitializedAsync()
    {
        entradas = await entradasService.Listar(e => true);
    }

    private void EditarEntrada(int entradaId)
    {
        NavigationManager.NavigateTo($"/Productos/Edit/{entradaId}");
    }
}
